# Compiled binaries (too large for git)
linux/libfairino/*.so
linux/libfairino/*.c
linux/fairino/build/
linux/fairino/*.so
linux/example/__pycache__/
linux/fairino/__pycache__/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Large PDF manuals (exceed GitHub's 100MB file limit — download separately)
docs/*.pdf

# Upstream Fairino MoveIt2 clone (129MB) — REDUNDANT: the same moveit configs
# are already vendored in ros2_ws/src/ros2_fr_gazebo. Re-clone if needed:
# FAIR-INNOVATION/fairino-moveit2
fairino-moveit2-main/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code local settings
.claude/

# ─────────────── ROS2 colcon workspace (ros2_ws) ───────────────
# Build artifacts — regenerated by `colcon build`, never committed.
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
# Pre-reorg fallback backup — kept on disk, not in git (history is the backup).
ros2_ws/legacy/
# colcon marker
ros2_ws/**/COLCON_IGNORE

# Nested upstream clone with its own .git (reference only; re-clone if needed:
# FAIR-INNOVATION/frcobot_ros2). Excluded to avoid a git submodule tangle.
frcobot_ros2_repo/
