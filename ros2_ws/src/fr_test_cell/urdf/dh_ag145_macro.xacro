<?xml version="1.0"?>
<!--
  DH AG-145 gripper macro.
  Adapted directly from upstream dh_robotics_ag145_gripper.urdf.xacro,
  with mesh paths repointed to our package and transmissions stripped.

  Usage:
    <xacro:include filename="$(find fr_test_cell)/urdf/dh_ag145_macro.xacro"/>
    <xacro:dh_ag145_gripper parent="wrist3_link" prefix="">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:dh_ag145_gripper>

  Parameters:
    parent             - link to attach the gripper to
    prefix             - name prefix for all gripper links/joints (e.g. "" or "ag145_")
                         Resulting links: ${prefix}gripper_base_link, etc.
    *origin            - block defining xyz/rpy of gripper base relative to parent
    grasp_link_offset  - Z offset (m) from gripper base_link to grasp_link (TCP).
                         Default 0.143 m = 5mm + ~138mm gripper Z extent.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dh_ag145_gripper" params="prefix parent *origin grasp_link_offset:=0.143">

    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <visual>
        <geometry>
          <mesh filename="package://fr_test_cell/meshes/dh_ag145/base_link.STL"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fr_test_cell/meshes/dh_ag145/base_link.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.0244063265095657"/>
        <origin xyz="4.22096179276271E-09 -8.66337897962713E-05 0.00351545641909857"/>
        <inertia ixx="5.17090412144922E-06" ixy="2.1574281704417E-13" ixz="-1.62385477492139E-13"
                 iyy="1.55299243331649E-05" iyz="-3.38892310365514E-09" izz="2.02963394517234E-05"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_finger1_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger1_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin rpy="0.0 0.0 ${pi}" xyz="-0.016 0 0.10586"/>
      <limit lower="-0.65" upper="0.0" velocity="100.0" effort="1000"/>
    </joint>

    <joint name="${prefix}gripper_finger2_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger2_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.016 0 0.10586"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="1000"/>
      <mimic joint="${prefix}gripper_finger1_joint"/>
    </joint>

    <link name="${prefix}gripper_finger1_knuckle_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/crank_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/crank_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.0039541"/>
        <origin xyz="0.019413 1.0484E-09 -0.0013793"/>
        <inertia ixx="1.1534E-06" ixy="-3.3307E-14" ixz="5.4175E-09"
                 iyy="6.8389E-07" iyz="7.7878E-15" izz="1.7667E-06"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_finger2_knuckle_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/crank_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/crank_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.0039541"/>
        <origin xyz="0.019413 0.00025 -0.0013793"/>
        <inertia ixx="1.1534E-06" ixy="-3.3307E-14" ixz="5.4175E-09"
                 iyy="6.8389E-07" iyz="7.7878E-15" izz="1.7667E-06"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_finger1_finger_joint" type="continuous">
      <parent link="${prefix}gripper_finger1_knuckle_link"/>
      <child link="${prefix}gripper_finger1_finger_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="0.036999 0 -0.00019698" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="105"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="0.5" offset="0"/>
    </joint>

    <joint name="${prefix}gripper_finger2_finger_joint" type="continuous">
      <parent link="${prefix}gripper_finger2_knuckle_link"/>
      <child link="${prefix}gripper_finger2_finger_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="0.036999 0 -0.00019698" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="105"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="0.5" offset="0"/>
    </joint>

    <link name="${prefix}gripper_finger1_finger_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/rod_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/rod_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.01141"/>
        <origin xyz="-0.012522 -9.1789E-09 0.034743"/>
        <inertia ixx="7.7273E-06" ixy="5.2238E-14" ixz="2.7021E-06"
                 iyy="7.7164E-06" iyz="2.4255E-13" izz="2.4386E-06"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_finger2_finger_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/rod_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/rod_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.01141"/>
        <origin xyz="-0.012522 -0.00025001 0.034743"/>
        <inertia ixx="7.7273E-06" ixy="5.2238E-14" ixz="2.7021E-06"
                 iyy="7.7164E-06" iyz="2.4255E-13" izz="2.4386E-06"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_finger1_inner_knuckle_joint" type="continuous">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger1_inner_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin rpy="0.0 0.0 ${pi}" xyz="-0.016 0 0.10586"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="105"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49" offset="0"/>
    </joint>

    <joint name="${prefix}gripper_finger2_inner_knuckle_joint" type="continuous">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_finger2_inner_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.016 0 0.10586"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="105"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49" offset="0"/>
    </joint>

    <link name="${prefix}gripper_finger1_inner_knuckle_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/proximal_phalanx_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/proximal_phalanx_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.017156"/>
        <origin xyz="-0.0051218 -8.3333E-10 0.038185"/>
        <inertia ixx="1.5431E-05" ixy="3.7731E-14" ixz="1.2687E-06"
                 iyy="1.2149E-05" iyz="-3.4837E-13" izz="3.7944E-06"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_finger2_inner_knuckle_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/proximal_phalanx_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/proximal_phalanx_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.017156"/>
        <origin xyz="-0.0051218 -8.3333E-10 0.038185"/>
        <inertia ixx="1.5431E-05" ixy="3.7731E-14" ixz="1.2687E-06"
                 iyy="1.2149E-05" iyz="-3.4837E-13" izz="3.7944E-06"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_finger1_finger_tip_joint" type="continuous">
      <parent link="${prefix}gripper_finger1_inner_knuckle_link"/>
      <child link="${prefix}gripper_finger1_finger_tip_link"/>
      <axis xyz="0 1 0"/>
      <origin xyz="-0.0081054 0 0.086119" rpy="0.0 0.0 0.0"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49"/>
    </joint>

    <joint name="${prefix}gripper_finger2_finger_tip_joint" type="continuous">
      <parent link="${prefix}gripper_finger2_inner_knuckle_link"/>
      <child link="${prefix}gripper_finger2_finger_tip_link"/>
      <axis xyz="0 1 0"/>
      <origin rpy="0.0 0.0 0.0" xyz="-0.0081054 0 0.086119"/>
      <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
      <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49"/>
    </joint>

    <link name="${prefix}gripper_finger1_finger_tip_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/distal_phalanx_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/distal_phalanx_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.012397"/>
        <origin xyz="0.0019731 -1.4867E-09 0.010631"/>
        <inertia ixx="1.0948E-06" ixy="4.5713E-14" ixz="1.3947E-07"
                 iyy="1.0269E-06" iyz="-5.5222E-15" izz="8.431E-07"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_finger2_finger_tip_link">
      <visual>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/distal_phalanx_Link.STL"/></geometry>
      </visual>
      <collision>
        <geometry><mesh filename="package://fr_test_cell/meshes/dh_ag145/distal_phalanx_Link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.012397"/>
        <origin xyz="0.0019731 3.1569E-10 0.010631"/>
        <inertia ixx="1.0948E-06" ixy="-9.4676E-15" ixz="1.3947E-07"
                 iyy="1.0269E-06" iyz="1.771E-14" izz="8.431E-07"/>
      </inertial>
    </link>

    <!-- TCP (grasp_link) — centered between fingers at grasp_link_offset from base -->
    <link name="${prefix}gripper_grasp_link"/>
    <joint name="${prefix}gripper_grasp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_grasp_link"/>
      <origin xyz="0 0 ${grasp_link_offset}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
