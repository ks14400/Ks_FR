<?xml version="1.0"?>
<!--
  Unchained build + FR16 robot mounted on Vention pedestal.

  Layout:
    - World origin = floor (z=0)
    - Unchained Junior CAD origin at world (0, 0, 0.629675)
    - Pedestal at CAD (73.98, 315.33, 1265.27) — child of Unchained
    - Robot mounted at pedestal top (which is the pedestal's local origin)
    - Robot's mounting yaw is tunable to match real-world mounting orientation

  Real-world workflow:
    Mount the FR16 on the Vention pedestal physically such that its "front"
    face (where the arm extends when j1=0) points in the same direction
    as in this simulation. Use robot_mount_yaw_deg to tune in sim, then
    physically rotate the real robot to match.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino10_v6_robot">

  <xacro:arg name="robot_model" default="fr10"/>
  <xacro:arg name="control_mode" default="mock"/>
  <xacro:arg name="device_height" default="1.21"/>
  <!-- Real FR16 is bolted to the pedestal plate rotated -45deg (connector on
       the right, parallel to the Unchained). Verified against hardware. -->
  <xacro:arg name="robot_mount_yaw_deg" default="0"/>
  <!-- Robot mount offset within pedestal frame.
       Pedestal STL origin sits at a corner; the mounting plate CENTER is at:
         X_center = (-323 + 97) / 2  = -113 mm
         Y_center = 0 (top)
         Z_center = (182 + 602) / 2  = +392 mm
       Override these if the actual mounting point differs. -->
  <xacro:arg name="robot_mount_x" default="-0.113"/>
  <xacro:arg name="robot_mount_y" default="0.0"/>
  <xacro:arg name="robot_mount_z" default="0.392"/>

  <!-- AG-145 gripper attached to wrist3_link -->
  <xacro:arg name="include_gripper" default="true"/>
  <xacro:arg name="gripper_mount_x" default="0.0"/>
  <xacro:arg name="gripper_mount_y" default="0.0"/>
  <!-- wrist3_link origin = j6 axis (wrist2 side). Tool flange is at +Z=0.1.
       +5 mm for the physical flange plate between wrist3 and gripper base. -->
  <xacro:arg name="gripper_mount_z" default="0.105"/>
  <xacro:arg name="gripper_mount_roll" default="0.0"/>
  <xacro:arg name="gripper_mount_pitch" default="0.0"/>
  <xacro:arg name="gripper_mount_yaw" default="0.0"/>
  <xacro:arg name="initial_positions_file"
             default="$(find fairino10_v6_moveit2_config)/config/initial_positions.yaml"/>

  <xacro:property name="robot_num" value="${'$(arg robot_model)'[2:]}"/>
  <xacro:property name="mount_yaw_deg" value="$(arg robot_mount_yaw_deg)"/>
  <xacro:property name="mount_yaw_rad" value="${float(mount_yaw_deg) * pi / 180.0}"/>

  <!-- ================ World ================ -->
  <link name="world"/>

  <!-- ================ PXRD SmartLab instrument ================ -->
  <!-- instrument_collision arg lets us DISABLE the instrument collision mesh
       to diagnose whether it's blocking the arm's path to the sample (which
       sits inside the instrument volume). Default true. -->
  <xacro:arg name="instrument_collision" default="true"/>
  <link name="pxrd_smartlab">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pxrd_cell/meshes/smartlab_visual.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"><color rgba="0.6 0.6 0.65 1.0"/></material>
    </visual>
    <xacro:if value="${'$(arg instrument_collision)' == 'true'}">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://pxrd_cell/meshes/smartlab_collision.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </xacro:if>
    <inertial>
      <mass value="80.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>

  <!-- Y-up → Z-up rotation, lifted to floor clearance -->
  <joint name="pxrd_smartlab_joint" type="fixed">
    <parent link="world"/>
    <child link="pxrd_smartlab"/>
    <origin xyz="0 0 $(arg device_height)" rpy="1.5708 0 0"/>
  </joint>

  <!-- ================ Deck markers (CAD frame) ================ -->
  <xacro:macro name="deck_marker" params="name x y z">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.012"/></geometry>
        <material name="${name}_color"><color rgba="1.0 0.5 0 1.0"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="pxrd_smartlab"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ============ Single PXRD sample location ============
       Unlike the unchained cell (7 decks), the PXRD has ONE pick/place spot:
       the position where the 96-well plate CENTER sits on the PXRD origin.
       So the marker is at (0,0,0) in the pxrd_smartlab (CAD Y-up) frame.
       Same deck_marker macro -> rpy=0 child of pxrd_smartlab, so the grasp
       logic (CAD-Y-up frame) works exactly like the unchained decks. -->
  <xacro:deck_marker name="pxrd_sample" x="0.0" y="0.0" z="0.0"/>

  <!-- ================ Lab table (loading station) ================
       A 30×30×70 cm box next to the pedestal. The plate gets staged here
       on the way out of (or into) the Unchained device.

       Table position is in WORLD frame (Z-up). The `table_top` frame is a
       child of `table` with rpy="1.5708 0 0" so its local +Y axis points
       up in world — same convention as deck markers. That lets the existing
       attach_plate_to_deck() logic work without special-casing the table.

       Tunable via include_table arg (default true) and the table_*_xyz args. -->
  <xacro:arg name="include_table" default="true"/>
  <xacro:arg name="table_x" default="0.7"/>
  <xacro:arg name="table_y" default="-1.3"/>
  <xacro:arg name="table_z" default="0.0"/>
  <xacro:arg name="table_w" default="0.30"/>     <!-- width  (X) -->
  <xacro:arg name="table_d" default="0.30"/>     <!-- depth  (Y) -->
  <xacro:arg name="table_h" default="0.70"/>     <!-- height (Z) -->

  <xacro:if value="${'$(arg include_table)' == 'true'}">
    <xacro:property name="tw" value="$(arg table_w)"/>
    <xacro:property name="td" value="$(arg table_d)"/>
    <xacro:property name="th" value="$(arg table_h)"/>

    <link name="table">
      <visual>
        <origin xyz="0 0 ${th/2}" rpy="0 0 0"/>
        <geometry><box size="${tw} ${td} ${th}"/></geometry>
        <material name="wood"><color rgba="0.55 0.35 0.18 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${th/2}" rpy="0 0 0"/>
        <geometry><box size="${tw} ${td} ${th}"/></geometry>
      </collision>
      <inertial>
        <mass value="20.0"/>
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="0.5"/>
      </inertial>
    </link>
    <joint name="table_joint" type="fixed">
      <parent link="world"/>
      <child link="table"/>
      <origin xyz="$(arg table_x) $(arg table_y) $(arg table_z)" rpy="0 0 0"/>
    </joint>

    <!-- table_top: green sphere at the top-center of the table, Y-up frame -->
    <link name="table_top">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.012"/></geometry>
        <material name="table_top_color"><color rgba="0.0 1.0 0.0 1.0"/></material>
      </visual>
    </link>
    <joint name="table_top_joint" type="fixed">
      <parent link="table"/>
      <child link="table_top"/>
      <!-- xyz: at top-center of table. rpy="π/2 0 0" rotates so table_top
           local +Y points along world +Z (up). -->
      <origin xyz="0 0 ${th}" rpy="1.5708 0 0"/>
    </joint>
  </xacro:if>

  <!-- ================ Well-plate model ================
       96-well SBS standard plate: 85.5 × 127.8 × 14 mm.

       Frame convention: the deck marker's parent (pxrd_smartlab) is CAD Y-up,
       so:
         - "vertical" in world  = unchained +Y (the plate's thickness axis)
         - plate footprint lies in the unchained X–Z plane

       Box size below uses (X, Y, Z) = (85.5, 14, 127.8) mm.
       The plate's origin defaults to its geometric center, so we offset +Y by
       half the thickness so the plate's BOTTOM sits flush on the deck marker.
       Default OFF: pick_place.py manages the plate as a CollisionObject so it
       can move with the gripper. Re-enable with include_plate:=true if you just
       want a static viewer. -->
  <xacro:arg name="include_plate" default="false"/>

  <xacro:macro name="well_plate" params="name parent_deck">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.0855 0.025 0.1278"/>
        </geometry>
        <material name="${name}_color"><color rgba="0.92 0.92 0.95 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.0855 0.025 0.1278"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.080"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_deck}"/>
      <child link="${name}"/>
      <!-- +Y is "up" in the deck frame; raise the plate by half its height (25mm/2)
           so its bottom face is flush with the deck dot. -->
      <origin xyz="0 0.0125 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${'$(arg include_plate)' == 'true'}">
    <xacro:well_plate name="plate_pxrd_sample" parent_deck="pxrd_sample"/>
  </xacro:if>

  <!-- ================ Tabbed well-plate (grab-handle design) ================
       The custom PXRD plate (check.STL) with a grab tab protruding off one end.
       Mesh is kept in its NATIVE CAD frame (only mm->m), so placing its origin
       at the SolidWorks-measured offset from the PXRD origin reproduces the CAD
       assembly exactly — same convention as the pedestal offset.

       SolidWorks: PXRD origin -> tabbed-plate origin = (8.04, 30.95, 92.38) mm.
       pxrd_smartlab IS the PXRD CAD frame, so SW (x,y,z) maps directly to the
       joint xyz in meters. Tunable via tabbed_plate_off_x/y/z; aim the tab with
       tabbed_plate_yaw_deg (about CAD vertical = Y = pitch slot).

       Visualization only — pick_place manages the moving copy as a
       CollisionObject. Toggle with include_tabbed_plate:=true. -->
  <!-- SolidWorks gave the translation only; the plate PART frame is rotated
       relative to the PXRD assembly frame. Dial rot_x/y/z (deg, about the
       pxrd_smartlab X/Y/Z axes) until the plate matches CAD: flat, wells up,
       tab pointing toward the arm. In this CAD frame Y is vertical, so a
       spin about the vertical axis (tab left/right) is rot_y_deg; flipping the
       plate upside-down is rot_x_deg or rot_z_deg = 180. -->
  <!-- Mesh is re-centered on the WELL-BODY center, so at offset (0,0,0) the
       wells sit on the PXRD origin (= the pxrd_sample point, by design) and any
       rotation spins the plate about the wells — position stays locked. Nudge
       the small offsets only for fine height/centering. -->
  <xacro:arg name="include_tabbed_plate" default="false"/>
  <xacro:arg name="tabbed_plate_off_x" default="0.005"/>
  <xacro:arg name="tabbed_plate_off_y" default="0.0085"/>
  <xacro:arg name="tabbed_plate_off_z" default="0.0"/>
  <xacro:arg name="tabbed_plate_rot_x_deg" default="180"/>
  <xacro:arg name="tabbed_plate_rot_y_deg" default="90"/>
  <xacro:arg name="tabbed_plate_rot_z_deg" default="0"/>
  <xacro:property name="tp_rx" value="${float('$(arg tabbed_plate_rot_x_deg)') * pi / 180.0}"/>
  <xacro:property name="tp_ry" value="${float('$(arg tabbed_plate_rot_y_deg)') * pi / 180.0}"/>
  <xacro:property name="tp_rz" value="${float('$(arg tabbed_plate_rot_z_deg)') * pi / 180.0}"/>

  <xacro:macro name="tabbed_plate" params="name parent x y z rx ry rz">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://pxrd_cell/meshes/the_plate_visual.stl"/>
        </geometry>
        <material name="${name}_color"><color rgba="0.30 0.55 0.85 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://pxrd_cell/meshes/the_plate_collision.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.090"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${rx} ${ry} ${rz}"/>
    </joint>
  </xacro:macro>

  <xacro:if value="${'$(arg include_tabbed_plate)' == 'true'}">
    <xacro:tabbed_plate name="tabbed_plate_viz" parent="pxrd_smartlab"
                        x="$(arg tabbed_plate_off_x)"
                        y="$(arg tabbed_plate_off_y)"
                        z="$(arg tabbed_plate_off_z)"
                        rx="${tp_rx}" ry="${tp_ry}" rz="${tp_rz}"/>
  </xacro:if>

  <!-- ================ Vention Pedestal ================ -->
  <!-- Two interchangeable pedestals (same top-plate origin & X/Z footprint):
         tall_pedestal=false -> 288080_v8.2  (585 mm tall)  [default]
         tall_pedestal=true  -> 355606_v3    (945 mm tall)  raises robot 360 mm
       When true, also set pedestal_off_y 360 mm higher (-0.6246 -> -0.2646)
       since both sit on the same floor. The launch does this automatically. -->
  <xacro:arg name="tall_pedestal" default="false"/>
  <xacro:property name="ped_mesh"
      value="${'pedestal_tall' if '$(arg tall_pedestal)' == 'true' else 'pedestal'}"/>
  <link name="pedestal">
    <inertial>
      <mass value="40.0"/>
      <inertia ixx="3.0" ixy="0" ixz="0" iyy="3.0" iyz="0" izz="3.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pxrd_cell/meshes/${ped_mesh}_visual.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"><color rgba="0.75 0.75 0.80 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pxrd_cell/meshes/${ped_mesh}_collision.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Pedestal origin offset from the PXRD origin (CAD frame, m). Measured in
       SolidWorks: (0.12763, -0.6246, 0.41012). The CAD Z component is the
       horizontal "depth" away from the instrument; raising it moves the
       pedestal back. Default here is +200mm from the measured value
       (0.41012 -> 0.61012) to give the arm more room to approach the sample.
       Tunable via launch args pedestal_off_x/y/z. -->
  <xacro:arg name="pedestal_off_x" default="0.12763"/>
  <xacro:arg name="pedestal_off_y" default="-0.6246"/>
  <xacro:arg name="pedestal_off_z" default="0.61012"/>
  <joint name="pedestal_joint" type="fixed">
    <parent link="pxrd_smartlab"/>
    <child link="pedestal"/>
    <origin xyz="$(arg pedestal_off_x) $(arg pedestal_off_y) $(arg pedestal_off_z)" rpy="0 0 0"/>
  </joint>

  <!-- ================ FR16 robot (arm chain only, no world link) ================ -->
  <!--
    The arm chain is rooted at base_link. We mount it on the pedestal.
    The pedestal frame is in CAD convention (Y-up) since it's a child of
    pxrd_smartlab. The robot's base_link expects ROS convention (Z-up).
    So we need a roll = -π/2 rotation to convert pedestal Y-up → robot Z-up.
    Plus an optional yaw to match real-world mounting orientation.
  -->
  <xacro:include filename="$(find pxrd_cell)/urdf/fairino_armonly/fairino${robot_num}_v6_armonly.urdf"/>

  <joint name="robot_mount_joint" type="fixed">
    <parent link="pedestal"/>
    <child link="base_link"/>
    <!-- xyz: centered on pedestal mounting plate (defaults computed above)
         roll=-π/2 converts pedestal Y-up to robot Z-up.
         Mount rotation goes in the PITCH slot, NOT yaw: the pedestal frame is
         Y-up, so its VERTICAL axis is Y. URDF rpy applies yaw about the parent
         Z (which is horizontal here) — that would TIP the arm. Pitch rotates
         about the parent Y axis = true vertical, spinning the robot in place.
         Net transform Ry(angle)*Rx(-π/2) keeps base_link Z pointing up for any
         angle and turns the robot about vertical. -->
    <origin xyz="$(arg robot_mount_x) $(arg robot_mount_y) $(arg robot_mount_z)"
            rpy="-1.5708 ${mount_yaw_rad} 0"/>
  </joint>

  <!-- ================ ros2_control ================ -->
  <xacro:property name="initial_positions"
                  value="${load_yaml('$(arg initial_positions_file)')['initial_positions']}"/>

  <ros2_control name="FairinoSystem" type="system">
    <hardware>
      <xacro:if value="${'$(arg control_mode)' == 'mock'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg control_mode)' == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg control_mode)' == 'hardware'}">
        <plugin>fairino_hardware/FairinoHardwareInterface</plugin>
      </xacro:if>
    </hardware>
    <xacro:macro name="joint_iface" params="jname">
      <joint name="${jname}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions[jname]}</param>
        </state_interface>
      </joint>
    </xacro:macro>
    <xacro:joint_iface jname="j1"/>
    <xacro:joint_iface jname="j2"/>
    <xacro:joint_iface jname="j3"/>
    <xacro:joint_iface jname="j4"/>
    <xacro:joint_iface jname="j5"/>
    <xacro:joint_iface jname="j6"/>

    <!-- Gripper master joint: mimics propagate inside MoveIt's planning model via URDF. -->
    <xacro:if value="${'$(arg include_gripper)' == 'true'}">
      <joint name="gripper_finger1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:if>
  </ros2_control>

  <xacro:if value="${'$(arg control_mode)' == 'gazebo'}">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find fairino${robot_num}_v6_moveit2_config)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ============ AG-145 Gripper attached to wrist3_link ============ -->
  <xacro:if value="${'$(arg include_gripper)' == 'true'}">
    <xacro:include filename="$(find pxrd_cell)/urdf/dh_ag145_macro.xacro"/>
    <xacro:dh_ag145_gripper parent="wrist3_link" prefix="">
      <origin xyz="$(arg gripper_mount_x) $(arg gripper_mount_y) $(arg gripper_mount_z)"
              rpy="$(arg gripper_mount_roll) $(arg gripper_mount_pitch) $(arg gripper_mount_yaw)"/>
    </xacro:dh_ag145_gripper>
  </xacro:if>

</robot>
